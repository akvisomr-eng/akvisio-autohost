# Neon pooled or direct PostgreSQL connection string. Keep secrets out of Git.
DATABASE_URL=

# Public business details
NEXT_PUBLIC_BUSINESS_NAME=Sans Rent Cars
NEXT_PUBLIC_BUSINESS_WHATSAPP=
NEXT_PUBLIC_DEFAULT_LOCALE=id-ID

# WhatsApp Cloud API: keep disabled until payment/approved trial and number selection.
WHATSAPP_OUTBOUND_ENABLED=false
# Set mode only after explicit authorization: "trial" or "production". Default is fail-closed.
WHATSAPP_OUTBOUND_MODE=
# Production requires explicit activation and a phone-number ID matching the tenant mapping.
WHATSAPP_PRODUCTION_ACTIVATED=false
WHATSAPP_PHONE_NUMBER_ID=
# Trial requires an approved test phone-number ID, ISO timestamps with timezone, and E.164 recipient allowlist.
# Trial duration is enforced at runtime and cannot exceed 72 hours.
WHATSAPP_TRIAL_PHONE_NUMBER_ID=
WHATSAPP_TRIAL_STARTS_AT=
WHATSAPP_TRIAL_ENDS_AT=
WHATSAPP_TRIAL_ALLOWED_RECIPIENTS=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Internal event processor. Use a long random secret; never expose it with NEXT_PUBLIC_.
WHATSAPP_PROCESSOR_SECRET=

# AI Host: manual staff-requested draft generation only; never sends outbound messages.
# Disabled by default. Configure only with an approved provider/test tenant.
AI_HOST_ENABLED=false
# HTTPS OpenAI-compatible base URL, normally including the provider API prefix (for example /v1).
AI_HOST_BASE_URL=
AI_HOST_API_KEY=
AI_HOST_MODEL=
# Optional provider-specific USD rates per 1,000 tokens; leave blank unless verified with provider pricing.
AI_HOST_INPUT_USD_PER_1K_TOKENS=
AI_HOST_OUTPUT_USD_PER_1K_TOKENS=

# Platform Super Admin: independent session and one-time first-admin bootstrap.
# Use separate random secrets of at least 32 characters. Never expose with NEXT_PUBLIC_.
PLATFORM_SESSION_SECRET=
PLATFORM_BOOTSTRAP_SECRET=

# Application
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=
BOOTSTRAP_SECRET=
